{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEMO_MODE=1",
        "DATABASE_PATH=data/demo.sqlite",
        "npm",
        "run",
        "dev"
      ],
      "port": 8090,
      "autoPort": true
    },
    {
      "name": "pathayam",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEV_LOGIN=1",
        "DATABASE_PATH=data/preview.sqlite",
        "npm",
        "run",
        "dev"
      ],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8099",
        "--directory",
        "website"
      ],
      "port": 8099
    }
  ]
}
