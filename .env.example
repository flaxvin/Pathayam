# Copy to .env for a homelab deployment. Never commit the real file.

# The public origin, exactly — OAuth redirects and cookie scoping depend on it.
BASE_URL=https://pathayam.example.com

# Google Cloud console → OAuth 2.0 Client ID (Web application).
# Authorised redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host port for the production service, bound to loopback so only the tunnel
# or reverse proxy can reach it.
PORT=8080

# Host port for the development profile.
DEV_PORT=8080

LOG_LEVEL=info
SESSION_DAYS=30

# R40.4 / Q24: the health page carries every other operational signal, but a
# failed backup or restore verification is the one failure class where silence
# loses data, so it goes out of band.
BACKUP_WEBHOOK_URL=

# R40.8 — the dead-man's switch, and the most important line in this file.
#
# The webhook above fires FROM this deployment. If the box is down, the tunnel
# dropped, or the job never ran, there is no process left to send it — so the
# one failure that must never be silent is silent exactly when it matters.
#
# This URL is pinged only on a SUCCESSFUL verified restore, at a monitor that
# alerts on the ping's absence. Any dead-man's-switch service works. Set its
# expected interval to the verification schedule plus slack, so a single slow
# run does not page anyone at 2am.
HEARTBEAT_URL=

# 07 §6.4 — Alpha Vantage, for direct equities only.
#
# Leave it empty. Q16 settled that this household holds mostly mutual funds,
# which MFAPI serves without a key and without a quota, and 10 §3.3's AMFI
# fallback covers MFAPI vanishing. P9 requires the app to work with every
# provider disabled, so an empty value here is a configuration, not a gap.
ALPHA_VANTAGE_KEY=

# F28: per-deployment module flags. Multi-currency is off because Q18 settled
# on ₹-only accounts; R31.5's revaluation path stays unbuilt until a foreign
# account actually exists.
FEATURE_LOANS=true
FEATURE_ASSETS=true
FEATURE_MULTI_CURRENCY=false

# DEV_LOGIN is deliberately not listed. It bypasses authentication entirely,
# is absent from the production image (R38.5), and the app refuses to start if
# it is set alongside any production indicator (R38.3). Use it only locally:
#
#   DEV_LOGIN=true npm run dev
