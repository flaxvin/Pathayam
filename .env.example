# Copy to .env for a homelab deployment. Never commit the real file.

# The public origin, exactly — OAuth redirects and cookie scoping depend on it.
BASE_URL=https://pathayam.example.com

# Google Cloud console → OAuth 2.0 Client ID (Web application).
# Authorised redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Host port for the production service, bound to loopback so only the tunnel
# or reverse proxy can reach it.
PORT=8080

# Host port for the development profile.
DEV_PORT=8080

LOG_LEVEL=info
SESSION_DAYS=30

# R40.4 / Q24: the health page carries every other operational signal, but a
# failed backup or restore verification is the one failure class where silence
# loses data, so it goes out of band.
BACKUP_WEBHOOK_URL=

# R40.8 — the dead-man's switch, and the most important line in this file.
#
# The webhook above fires FROM this deployment. If the box is down, the tunnel
# dropped, or the job never ran, there is no process left to send it — so the
# one failure that must never be silent is silent exactly when it matters.
#
# This URL is pinged only on a SUCCESSFUL verified restore, at a monitor that
# alerts on the ping's absence. Any dead-man's-switch service works. Set its
# expected interval to the verification schedule plus slack, so a single slow
# run does not page anyone at 2am.
HEARTBEAT_URL=

# 07 §6.4 — Alpha Vantage, for direct equities only.
#
# Leave it empty. Q16 settled that this household holds mostly mutual funds,
# which MFAPI serves without a key and without a quota, and 10 §3.3's AMFI
# fallback covers MFAPI vanishing. P9 requires the app to work with every
# provider disabled, so an empty value here is a configuration, not a gap.
ALPHA_VANTAGE_KEY=

# PLAN-1 · What this instance offers, and its limits.
#
# PLAN picks a preset: selfhost (the default — everything on, no limits),
# solo, household or power. Each line below that is given a value wins over
# the preset; left empty, it takes the preset's. A value the app cannot read
# (PLAN=family, FEATURE_LOANS=flase) stops it at startup. The full table, with
# each plan's values, is in docs/operations.md under "Plans and modules".
#
# A module switched off disappears from every page and keeps its data, so
# switching it back on brings it back as it was.
PLAN=

# Members at once: a whole number, or "unlimited". solo 1, household 5,
# power and selfhost unlimited.
MAX_MEMBERS=
# How far back a backup can be restored from, in days: every backup of the
# last two days, then one a day. solo 30, household 90, power 365; selfhost
# keeps the newest 14 whatever their age.
BACKUP_RETENTION_DAYS=

# Modules. true/false (or 1/0, yes/no, on/off). Off on solo: loans, family
# loans, assets, API tokens, AI. Off on every hosted plan: Gmail.
FEATURE_LOANS=
FEATURE_FAMILY_LOANS=
# Portfolio, CAS and SafeGold, net worth, financial independence, price feeds.
FEATURE_ASSETS=
# Deposit terms on accounts, and their maturities.
FEATURE_DEPOSITS=
FEATURE_INSURANCE=
FEATURE_GOALS=
FEATURE_TAX=
# Reports, Query and its CSV. Search stays.
FEATURE_REPORTS=
FEATURE_SCHEDULES=
FEATURE_RULES=
# Receipts on transactions.
FEATURE_ATTACHMENTS=
FEATURE_IMPORT_CSV=
FEATURE_IMPORT_PDF=
# YNAB and Actual Budget exports.
FEATURE_IMPORT_BUDGET_APP=
FEATURE_GMAIL=
FEATURE_API_TOKENS=
# AI connections: /mcp, signing in from an AI app, Connect an AI, and
# /export/analysis.json.
FEATURE_AI=
# Off in every preset: Q18 settled on ₹-only accounts, and R31.5's
# revaluation path stays unbuilt until a foreign account actually exists.
FEATURE_MULTI_CURRENCY=

# DEV_LOGIN is deliberately not listed. It bypasses authentication entirely,
# is absent from the production image (R38.5), and the app refuses to start if
# it is set alongside any production indicator (R38.3). Use it only locally:
#
#   DEV_LOGIN=true npm run dev

# A public demonstration instance: anyone who can reach it may enter and click
# around, and the data is invented. Off unless set. Refuses to start alongside
# DEV_LOGIN, Google or OIDC credentials, or LOCAL_LOGIN, or against a database
# holding a connected mailbox, a saved statement identity, a member's password
# or a linked Google account — each of which means it is in real use.
# Seed it with: DATA_DIR=./demo-data npm run demo
DEMO_MODE=
