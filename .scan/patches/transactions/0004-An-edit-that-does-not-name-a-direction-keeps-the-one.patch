From 78a98ba2fefbb277de4cd09db89485ae9433d887 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 16:31:15 +0000
Subject: [PATCH] An edit that does not name a direction keeps the one the
 transaction had
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

POST /transaction/:id read a missing `direction` as "out", /add's default.
An API caller moving a ₹50,000 salary credit's date turned it into ₹50,000
of spending with no envelope, under "Saved." Silence about tags and envelope
lines already leaves those alone; silence about direction now does too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016zXWwzys3K4XksLh3rrcKu
---
 src/app.ts                       | 12 ++++++++++--
 src/web/transaction-edit.test.ts | 24 ++++++++++++++++++++++++
 2 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/src/app.ts b/src/app.ts
index ca209a6..401945a 100644
--- a/src/app.ts
+++ b/src/app.ts
@@ -4002,9 +4002,17 @@ export function buildApp(deps: AppDeps): { router: Router; middleware: ((ctx: Re
     return once(ctx, a, () => {
       const magnitude = Math.abs(amountField(field(ctx.body, "amount")));
       const actor = actorFor(a, "ui", ctx.req.headers["idempotency-key"] as string);
-      const signed = isTransferLeg
+      /*
+       * A post that does not say which way the money went keeps the way it
+       * went. Reading silence as "out" — /add's default — turned a ₹50,000
+       * salary credit into ₹50,000 of spending, with no envelope, under
+       * "Saved.", when an API caller only moved its date. Silence about tags
+       * and envelopes already leaves those alone.
+       */
+      const direction = field(ctx.body, "direction");
+      const signed = isTransferLeg || (direction !== "in" && direction !== "out")
         ? (transaction.amount < 0 ? -magnitude : magnitude)
-        : field(ctx.body, "direction") === "in" ? magnitude : -magnitude;
+        : direction === "in" ? magnitude : -magnitude;
 
       // L1 · A renamed payee is the signal. Resolved here so the rename and the
       // rest of the edit land in one update, and so the *old* name is still
diff --git a/src/web/transaction-edit.test.ts b/src/web/transaction-edit.test.ts
index c6ab8a1..f34f66f 100644
--- a/src/web/transaction-edit.test.ts
+++ b/src/web/transaction-edit.test.ts
@@ -342,3 +342,27 @@ describe("an edit with a date that is not a date", () => {
     assert.deepEqual([row.amount, row.date], [-rupees(700), "2026-09-05"]);
   });
 });
+
+describe("an edit that does not say which way the money went", () => {
+  test("keeps the direction it had, rather than turning income into spending", async () => {
+    // An API caller moving a salary credit's date posts the amount and the date.
+    const salary = createTransaction(db, actor, {
+      accountId: bank, amount: rupees(50000), date: "2026-09-01",
+    });
+    const res = await app.post(`/transaction/${salary.id}`, { amount: "50000", date: "02-09-2026" });
+    assert.equal(res.status, 303);
+    const row = getTransaction(db, salary.id)!;
+    assert.deepEqual([row.amount, row.date], [rupees(50000), "2026-09-02"]);
+  });
+
+  test("an explicit direction still turns it round", async () => {
+    const t = createTransaction(db, actor, {
+      accountId: bank, amount: rupees(300), date: "2026-09-01",
+    });
+    const res = await app.post(`/transaction/${t.id}`, {
+      amount: "300", direction: "out", date: "01-09-2026", split_category_0: groceries,
+    });
+    assert.equal(res.status, 303);
+    assert.equal(getTransaction(db, t.id)!.amount, -rupees(300));
+  });
+});
