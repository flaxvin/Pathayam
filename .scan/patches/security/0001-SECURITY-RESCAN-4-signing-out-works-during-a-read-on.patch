Subject: [PATCH] SECURITY-RESCAN-4: signing out works during a read-only view

The read-only impersonation guard refused every write except the two
impersonation controls, so Sign out answered 403 to somebody viewing as
another member and left the session open on a shared device.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016zXWwzys3K4XksLh3rrcKu
---
 src/app.ts                            |  4 ++-
 src/web/impersonation-signout.test.ts | 38 +++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)
 create mode 100644 src/web/impersonation-signout.test.ts

diff --git a/src/app.ts b/src/app.ts
index 8e8d2a5..317cc9c 100644
--- a/src/app.ts
+++ b/src/app.ts
@@ -574,7 +574,9 @@ export function buildApp(deps: AppDeps): { router: Router; middleware: ((ctx: Re
       // B51: `/impersonate/writes` must pass even in read-only mode — it *is*
       // the toggle. Blocking it (as this did) made read-only impersonation a
       // one-way door, contradicting the error's own "Enable writes first".
-      const IMPERSONATION_CONTROLS = new Set(["/impersonate/exit", "/impersonate/writes"]);
+      // Signing out is the same kind of door: refusing it left a read-only
+      // viewer unable to end their own session on a shared device.
+      const IMPERSONATION_CONTROLS = new Set(["/impersonate/exit", "/impersonate/writes", "/signout"]);
       if (ctx.method !== "GET" && !auth.canWrite && !IMPERSONATION_CONTROLS.has(path)) {
         throw new HttpError(
           403,
diff --git a/src/web/impersonation-signout.test.ts b/src/web/impersonation-signout.test.ts
new file mode 100644
index 0000000..81a4c1d
--- /dev/null
+++ b/src/web/impersonation-signout.test.ts
@@ -0,0 +1,38 @@
+/**
+ * Signing out is always possible, including in the middle of a read-only view.
+ *
+ * The read-only guard refused every non-GET except the two impersonation
+ * controls, so "Sign out of this device" answered 403 — "Enable writes first,
+ * or exit" — to somebody viewing as another member. On a shared laptop that
+ * left the session (the real member's) signed in after they believed they had
+ * left it.
+ */
+
+import { test, describe } from "node:test";
+import assert from "node:assert/strict";
+import { freshDb, seedMember, startTestApp } from "./harness.test-data.ts";
+import { queryOne } from "../db/db.ts";
+
+describe("signing out while viewing as another member", () => {
+  test("ends the session in read-only mode", async () => {
+    const db = freshDb();
+    seedMember(db, "m-ravi", "Ravi");
+    seedMember(db, "m-priya", "Priya");
+    const app = await startTestApp(db, { memberId: "m-ravi", config: { adminDebug: true } });
+    try {
+      assert.equal((await app.post("/impersonate/start", { member_id: "m-priya" })).status, 303);
+
+      const res = await app.post("/signout", {});
+      assert.equal(res.status, 303);
+      assert.equal(res.headers.get("location"), "/signin");
+      assert.equal(
+        queryOne(db, `SELECT 1 FROM sessions WHERE member_id = 'm-ravi' AND revoked_at IS NULL`),
+        null,
+      );
+      // And the cookie no longer opens anything.
+      assert.equal((await app.get("/settings")).status, 303);
+    } finally {
+      await app.close();
+    }
+  });
+});
