diff --git a/docs/security.md b/docs/security.md
index b1e3301..f9adc06 100644
--- a/docs/security.md
+++ b/docs/security.md
@@ -183,6 +183,10 @@ two price providers. User-supplied values reach only path segments and query
 values, through `encodeURIComponent`. `BACKUP_WEBHOOK_URL` and `HEARTBEAT_URL`
 are operator-configured.
 
+OpenID Connect discovery (`{OIDC_ISSUER}/.well-known/openid-configuration`)
+is bounded at ten seconds, like the price providers' fetches; a provider that
+does not answer in time makes `/auth/oidc` answer 503, not hang.
+
 ## Dependencies
 
 None at runtime.
diff --git a/src/auth/oidc.test.ts b/src/auth/oidc.test.ts
index d904677..78759ad 100644
--- a/src/auth/oidc.test.ts
+++ b/src/auth/oidc.test.ts
@@ -112,6 +112,31 @@ describe("discovery", () => {
     );
   });
 
+  test("a provider that never answers is given up on, not waited for", async () => {
+    /*
+     * A provider that accepts the connection and then says nothing held
+     * /auth/oidc open for as long as the socket lived, and every retry the
+     * person made held another. The wait is bounded like the other outbound
+     * fetches, and the give-up is an OAuthError, which the route answers 503.
+     */
+    let signalled = false;
+    const impl = ((_url: string, init?: RequestInit) => new Promise<Response>((_ok, fail) => {
+      const signal = init?.signal;
+      // Without a signal the real provider would hang for ever; fail plainly
+      // instead, so the test reports the missing timeout rather than stalling.
+      if (!signal) return fail(new Error("no signal given"));
+      signalled = true;
+      signal.addEventListener("abort", () => fail(signal.reason));
+    })) as unknown as typeof fetch;
+    const started = Date.now();
+    await assert.rejects(
+      () => discover(ISSUER, impl, { timeoutMs: 50 }),
+      (e: Error) => e instanceof OAuthError && /did not answer within/.test(e.message),
+    );
+    assert.ok(signalled, "the fetch was given no way to be cancelled");
+    assert.ok(Date.now() - started < 5_000, "the timeout did not apply");
+  });
+
   test("a 404 points at the setting to check", async () => {
     const { impl } = stubFetch({}, 404);
     await assert.rejects(() => discover(ISSUER, impl), (e: Error) => /OIDC_ISSUER/.test(e.message));
diff --git a/src/auth/oidc.ts b/src/auth/oidc.ts
index 76a8cbb..7a19eac 100644
--- a/src/auth/oidc.ts
+++ b/src/auth/oidc.ts
@@ -70,9 +70,18 @@ export function clearDiscoveryCache(): void {
   cache.clear();
 }
 
+/**
+ * How long discovery may take. The same bound as the price providers' default
+ * (portfolio/providers.ts): a provider that accepts the connection and then
+ * says nothing otherwise held /auth/oidc open for as long as the socket lived,
+ * and each retry the person made held another.
+ */
+const DISCOVERY_TIMEOUT_MS = 10_000;
+
 export async function discover(
   issuer: string,
   fetchImpl: typeof fetch = fetch,
+  opts: { timeoutMs?: number } = {},
 ): Promise<Discovery> {
   const cached = cache.get(issuer);
   if (cached) return cached;
@@ -85,25 +94,43 @@ export async function discover(
    */
   const url = `${issuer.replace(/\/+$/, "")}/.well-known/openid-configuration`;
 
-  let response: Response;
-  try {
-    response = await fetchImpl(url, { headers: { accept: "application/json" } });
-  } catch (error) {
-    throw new OAuthError(
-      `Could not reach the identity provider at ${url}. ${(error as Error).message}`,
-    );
-  }
-  if (!response.ok) {
-    throw new OAuthError(
-      `The identity provider at ${url} answered ${response.status}. Check OIDC_ISSUER.`,
-    );
-  }
+  const timeoutMs = opts.timeoutMs ?? DISCOVERY_TIMEOUT_MS;
+  const controller = new AbortController();
+  const timer = setTimeout(
+    () => controller.abort(new DOMException("The operation timed out.", "TimeoutError")),
+    timeoutMs,
+  );
+  const timedOut = () =>
+    new OAuthError(`The identity provider at ${url} did not answer within ${timeoutMs / 1000} seconds.`);
 
   let document: Partial<Discovery>;
   try {
-    document = await response.json() as Partial<Discovery>;
-  } catch {
-    throw new OAuthError(`${url} did not return a discovery document.`);
+    let response: Response;
+    try {
+      response = await fetchImpl(url, {
+        headers: { accept: "application/json" }, signal: controller.signal,
+      });
+    } catch (error) {
+      if (controller.signal.aborted) throw timedOut();
+      throw new OAuthError(
+        `Could not reach the identity provider at ${url}. ${(error as Error).message}`,
+      );
+    }
+    if (!response.ok) {
+      throw new OAuthError(
+        `The identity provider at ${url} answered ${response.status}. Check OIDC_ISSUER.`,
+      );
+    }
+
+    // The body is under the same bound: a provider can stall after the headers.
+    try {
+      document = await response.json() as Partial<Discovery>;
+    } catch {
+      if (controller.signal.aborted) throw timedOut();
+      throw new OAuthError(`${url} did not return a discovery document.`);
+    }
+  } finally {
+    clearTimeout(timer);
   }
 
   if (!document.authorization_endpoint || !document.token_endpoint || !document.issuer) {
diff --git a/src/web/oidc-timeout.test.ts b/src/web/oidc-timeout.test.ts
new file mode 100644
index 0000000..b84a87a
--- /dev/null
+++ b/src/web/oidc-timeout.test.ts
@@ -0,0 +1,39 @@
+/**
+ * /auth/oidc answers 503 when the provider's discovery document times out,
+ * rather than holding the request open for as long as the provider does.
+ */
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { freshDb, startTestApp } from "./harness.test-data.ts";
+
+// Not shared with any other test: discovery is cached per issuer for the life
+// of the process.
+const ISSUER = "https://slow-idp.example/realms/home";
+
+test("a discovery fetch that times out is a 503, not a hang or a 500", async () => {
+  let signalled = false;
+  // Stands in for the timer firing: rejects the way fetch does on a timeout,
+  // but only if the route gave the fetch a signal to be cancelled by.
+  const fetchImpl = ((_url: string, init?: RequestInit) => {
+    // Without a signal the real provider would hang for ever; fail plainly
+    // instead, so the test reports the missing timeout rather than stalling.
+    if (!init?.signal) return Promise.reject(new Error("no signal given"));
+    signalled = true;
+    return Promise.reject(new DOMException("The operation timed out.", "TimeoutError"));
+  }) as unknown as typeof fetch;
+
+  const app = await startTestApp(freshDb(), {
+    memberId: null,
+    config: { oidc: { issuer: ISSUER, clientId: "c", clientSecret: "s", label: "Home SSO" } },
+    fetchImpl,
+  });
+  try {
+    const res = await app.get("/auth/oidc", { signal: AbortSignal.timeout(5_000) });
+    assert.ok(signalled, "discovery was fetched with no timeout of its own");
+    assert.equal(res.status, 503);
+    assert.deepEqual(app.failures, [], "a slow provider was recorded as this server's fault");
+  } finally {
+    await app.close();
+  }
+});
