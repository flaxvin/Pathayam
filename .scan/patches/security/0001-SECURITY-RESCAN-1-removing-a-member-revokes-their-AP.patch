From 2e1fed7a1a1e1e44ea3f3e0ea4e6ee9bb7115103 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 16:23:17 +0000
Subject: [PATCH] SECURITY-RESCAN-1: removing a member revokes their API tokens

Reinstating a removed member brought back every token they had minted:
the request path refused a removed member's token only by reading the
allow-list, so re-adding them made the old secrets work again, though
their sessions stayed revoked. removeMember now revokes their tokens.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016zXWwzys3K4XksLh3rrcKu
---
 src/auth/sessions.ts                  |  8 ++++++
 src/web/removed-member-tokens.test.ts | 38 +++++++++++++++++++++++++++
 2 files changed, 46 insertions(+)
 create mode 100644 src/web/removed-member-tokens.test.ts

diff --git a/src/auth/sessions.ts b/src/auth/sessions.ts
index 24c7db8..e6322b9 100644
--- a/src/auth/sessions.ts
+++ b/src/auth/sessions.ts
@@ -122,6 +122,14 @@ export function removeMember(db: DB, actor: Actor, id: string): void {
     }
     execute(db, `UPDATE members SET removed_at = ?, allowed = 0 WHERE id = ?`, nowIST(), id);
     execute(db, `UPDATE sessions SET revoked_at = ? WHERE member_id = ? AND revoked_at IS NULL`, nowIST(), id);
+    /*
+     * Their API tokens end with their access too. The request path already
+     * refused a removed member's token, but only by reading the allow-list —
+     * so reinstating them brought every token they had minted back to life,
+     * scripts and all, though their sessions stayed signed out. Reinstating
+     * restores a member, not the credentials they held before.
+     */
+    execute(db, `UPDATE api_tokens SET revoked_at = ? WHERE member_id = ? AND revoked_at IS NULL`, nowIST(), id);
     appendEvent(db, actor, {
       entity: "member", entityId: id, action: "remove", before, after: getMember(db, id),
       summary: `Removed ${before.name} from the household`,
diff --git a/src/web/removed-member-tokens.test.ts b/src/web/removed-member-tokens.test.ts
new file mode 100644
index 0000000..fd190d4
--- /dev/null
+++ b/src/web/removed-member-tokens.test.ts
@@ -0,0 +1,38 @@
+/**
+ * A removed member's credentials stay dead when the member comes back.
+ */
+
+import { test, describe } from "node:test";
+import assert from "node:assert/strict";
+import { freshDb, seedMember, startTestApp } from "./harness.test-data.ts";
+import { mintToken } from "../auth/tokens.ts";
+import { inviteMember, removeMember } from "../auth/sessions.ts";
+
+const system = { memberId: null, realMemberId: null, source: "system" as const, idempotencyKey: null };
+
+describe("a removed member's API token", () => {
+  test("does not come back to life when the member is reinstated", async () => {
+    const db = freshDb();
+    seedMember(db, "m-ravi", "Ravi");
+    seedMember(db, "m-priya", "Priya");
+    const { secret } = mintToken(
+      db, { ...system, memberId: "m-priya", source: "ui" },
+      { name: "script", scope: "read-write" },
+    );
+
+    removeMember(db, { ...system, memberId: "m-ravi", source: "ui" }, "m-priya");
+    // Re-adding Priya restores her membership — not a credential minted before
+    // she was removed, which the household believed had died with her access.
+    inviteMember(db, { ...system, memberId: "m-ravi", source: "ui" }, { email: "m-priya@example.com" });
+
+    const app = await startTestApp(db, { memberId: null });
+    try {
+      const res = await app.get("/settings", {
+        headers: { Authorization: `Bearer ${secret}`, Accept: "application/json" },
+      });
+      assert.equal(res.status, 401);
+    } finally {
+      await app.close();
+    }
+  });
+});
