From f08bc92e217c40c4e8faea66a5c942abdb600193 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 18:55:02 +0000
Subject: [PATCH] D5: small controls reach the 44px tap target on a touch
 screen

docs/screens.md promises tap targets of at least 44px, but the small
buttons (the header's theme toggle and member link, Skip, Use it, No
thanks, Remove), the budget pills and the assign boxes were 34-38px, and
two goal disclosures set 36px inline. Compact is right under a mouse and a
miss under a thumb, so a @media (pointer: coarse) block at the end of the
sheet lifts every rule with a smaller min-height to var(--tap). Desktop
layout is unchanged. The inline summaries became a .summary-small class,
since an inline style cannot be reached by a media query.

Tests: every min-height under 44px in the stylesheet is lifted in the
coarse block, and no page sets one inline.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016zXWwzys3K4XksLh3rrcKu
---
 src/web/mobile-layout.test.ts | 51 +++++++++++++++++++++++++++++++++++
 src/web/pages/analysis.ts     |  4 +--
 src/web/styles.ts             | 23 ++++++++++++++++
 3 files changed, 76 insertions(+), 2 deletions(-)

diff --git a/src/web/mobile-layout.test.ts b/src/web/mobile-layout.test.ts
index 23fe2e4..7894803 100644
--- a/src/web/mobile-layout.test.ts
+++ b/src/web/mobile-layout.test.ts
@@ -78,3 +78,54 @@ describe("B118 · every table scrolls inside its own box", () => {
     assert.match(STYLESHEET, /\.table-scroll \{[^}]*overflow-x: auto/);
   });
 });
+
+/**
+ * D5 · A finger gets 44px, a mouse may have less.
+ *
+ * docs/screens.md promises tap targets of at least 44px. The small buttons —
+ * the header's theme toggle and member link, the budget pills, Skip, Use it,
+ * No thanks, Remove — are 34px, which is a fine size under a mouse pointer and
+ * too small under a thumb. The rule: anything that sets a min-height below
+ * --tap is lifted back to --tap when the primary pointer is coarse, so a
+ * desktop keeps its compact rows and a phone gets the promised target.
+ */
+describe("D5 · small controls reach --tap on a touch screen", () => {
+  const coarse = /@media \(pointer: coarse\) \{([\s\S]*?)\n\}/.exec(STYLESHEET);
+
+  test("there is a coarse-pointer block that sets min-height: var(--tap)", () => {
+    assert.ok(coarse, "no @media (pointer: coarse) block in the stylesheet");
+    assert.match(coarse[1], /min-height: var\(--tap\)/);
+  });
+
+  test("every rule with a min-height under 44px is lifted in that block", () => {
+    assert.ok(coarse);
+    const outside = STYLESHEET.replace(coarse[0], "");
+    const offenders: string[] = [];
+    for (const m of outside.matchAll(/([^{}]+)\{[^}]*min-height: (\d+)px/g)) {
+      if (Number(m[2]) >= 44) continue;
+      const selector = m[1].replace(/\/\*[\s\S]*?\*\//g, "").trim();
+      if (!coarse[1].includes(selector)) offenders.push(`${selector} (${m[2]}px)`);
+    }
+    assert.deepEqual(offenders, [], `too small to tap: ${offenders.join(", ")}`);
+  });
+
+  test("the small controls named in the decision are covered", () => {
+    assert.ok(coarse);
+    for (const sel of [".button-small", ".scope-switch a"]) {
+      assert.ok(coarse[1].includes(sel), `${sel} is not lifted on a touch screen`);
+    }
+  });
+});
+
+describe("D5 · no page sets a small min-height inline, out of the media query's reach", () => {
+  test("pages carry no inline min-height under 44px", () => {
+    const offenders: string[] = [];
+    for (const file of readdirSync(join(here, "pages")).filter((f) => f.endsWith(".ts") && !f.includes(".test."))) {
+      const source = readFileSync(join(here, "pages", file), "utf8");
+      for (const m of source.matchAll(/style="[^"]*min-height:\s*(\d+)px/g)) {
+        if (Number(m[1]) < 44) offenders.push(`${file}: ${m[0]}`);
+      }
+    }
+    assert.deepEqual(offenders, [], "an inline style cannot be lifted by @media (pointer: coarse)");
+  });
+});
diff --git a/src/web/pages/analysis.ts b/src/web/pages/analysis.ts
index f478cab..52926b3 100644
--- a/src/web/pages/analysis.ts
+++ b/src/web/pages/analysis.ts
@@ -1199,7 +1199,7 @@ function renderGoalCard(g: GoalProgress): SafeHtml {
         </form>
         <!-- BUDGET-14 · Rolling over needs the goal it rolls into. -->
         <details style="margin-top:.5rem">
-          <summary style="min-height:36px;display:flex;align-items:center;cursor:pointer;color:var(--text-muted);font-size:.9rem">
+          <summary class="summary-small">
             Roll into a new goal
           </summary>
           <form method="post" action="/goals/${g.goal.id}/complete" style="margin-top:.5rem">
@@ -1227,7 +1227,7 @@ function renderGoalCard(g: GoalProgress): SafeHtml {
 
       <!-- F11 · Edit and delete. -->
       <details style="margin-top:.75rem">
-        <summary style="min-height:36px;display:flex;align-items:center;cursor:pointer;color:var(--text-muted);font-size:.9rem">
+        <summary class="summary-small">
           Edit or remove
         </summary>
         <form method="post" action="/goals/${g.goal.id}/edit" style="margin-top:.5rem">
diff --git a/src/web/styles.ts b/src/web/styles.ts
index 21885eb..09460a5 100644
--- a/src/web/styles.ts
+++ b/src/web/styles.ts
@@ -719,4 +719,27 @@ dialog::backdrop { background: rgba(0,0,0,.45); }
 .overview-items { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
 .overview-list .amount { white-space: nowrap; }
 .scope-tabs { display: flex; flex-wrap: wrap; gap: .4rem; }
+/* A quiet disclosure under a card ("Edit or remove"): compact under a mouse. */
+.summary-small {
+  min-height: 36px; display: flex; align-items: center; cursor: pointer;
+  color: var(--text-muted); font-size: .9rem;
+}
+
+/*
+ * D5 · A finger gets the full tap target; a mouse keeps the compact rows.
+ *
+ * The small controls above are 34px (38px for an assign box) because on a
+ * desktop a row of 44px buttons is a row of slabs. Under a thumb that is a miss
+ * waiting to happen, and docs/screens.md promises 44px. So whenever the primary
+ * pointer is coarse, everything that set a smaller min-height is lifted to
+ * --tap. Last in the sheet, so it outranks those rules at equal specificity.
+ */
+@media (pointer: coarse) {
+  .button-small,
+  .scope-switch a,
+  .assign-cell input,
+  .summary-small {
+    min-height: var(--tap);
+  }
+}
 `;
