From 574d89b29fbb9cac679ed8856fe443d2998aaec1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 16:23:11 +0000
Subject: [PATCH] IMPORTS-1: a tab-separated file with lakh figures is still
 tab-separated

detectDelimiter picked the most frequent character, so a TSV whose
"1,23,456.78" balances and comma-laden narrations outnumbered its tabs
was split on commas: the header became one cell, nothing could be
guessed, and the mapping screen (whose delimiter is hidden) could not
fix it. The delimiter is now the one that cuts the most lines into a
steady number of columns.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016zXWwzys3K4XksLh3rrcKu
---
 src/import/csv.test.ts | 22 ++++++++++++++++++++++
 src/import/csv.ts      | 34 +++++++++++++++++++++++++++-------
 2 files changed, 49 insertions(+), 7 deletions(-)

diff --git a/src/import/csv.test.ts b/src/import/csv.test.ts
index 8af4132..1f6f207 100644
--- a/src/import/csv.test.ts
+++ b/src/import/csv.test.ts
@@ -32,6 +32,28 @@ describe("parseDelimited", () => {
     assert.equal(detectDelimiter("a\tb\tc\n1\t2\t3"), "\t");
     assert.equal(detectDelimiter("a;b;c\n1;2;3"), ";");
   });
+
+  test("a tab-separated file whose figures and narrations carry more commas than tabs is still tab-separated", () => {
+    // Lakh grouping and comma-laden narrations gave the first lines more
+    // commas than tabs, so the file split on commas, the header became one
+    // cell, and nothing could be mapped (the screen cannot change delimiter).
+    const text = "Txn Date\tNarration\tDebit\tCredit\tBalance\n" +
+      "01/08/2026\tUPI/FICTIONAL CAFE, KOCHI, KL, IN\t1,250.00\t\t1,23,456.78\n" +
+      "02/08/2026\tNEFT/EXAMPLE TRADERS, PVT, LTD\t\t1,50,000.00\t2,73,456.78\n";
+    assert.equal(detectDelimiter(text), "\t");
+    const { mapping, result } = parseStatement(text);
+    assert.ok(mapping);
+    assert.equal(result.records.length, 2);
+    assert.equal(result.records[0]!.amount, -rupees(1250));
+  });
+
+  test("a CSV with quoted commas and a preamble stays comma-separated", () => {
+    const text = "Account Name:,FICTIONAL PERSON\n" +
+      "Date,Narration,Amount\n" +
+      '01-08-2026,"SHOP, ONE",100.00\n' +
+      '02-08-2026,"SHOP; TWO; THREE",200.00\n';
+    assert.equal(detectDelimiter(text), ",");
+  });
 });
 
 describe("guessMapping", () => {
diff --git a/src/import/csv.ts b/src/import/csv.ts
index 37b9d21..eaad61c 100644
--- a/src/import/csv.ts
+++ b/src/import/csv.ts
@@ -112,14 +112,34 @@ function parseDelimitedOnce(
   return { rows, unclosedQuoteAt: null };
 }
 
-/** Guess the delimiter from the first few lines. Some banks emit TSV or `;`. */
+/**
+ * Guess the delimiter from the first few lines. Some banks emit TSV or `;`.
+ *
+ * Judged by which delimiter cuts the lines into a steady number of columns,
+ * not by which character is most frequent. Counting characters chose the
+ * comma for a tab-separated statement whenever lakh figures ("1,23,456.78")
+ * and narrations ("CAFE, KOCHI, KL") put more commas than tabs in the first
+ * ten lines: the header became one cell, nothing could be guessed, and the
+ * mapping screen offered comma-split columns it gives no way to change.
+ */
 export function detectDelimiter(text: string): string {
-  const sample = text.split("\n").slice(0, 10).join("\n");
-  const counts = [",", "\t", ";", "|"].map(
-    (d) => [d, sample.split(d).length - 1] as const,
-  );
-  counts.sort((a, b) => b[1] - a[1]);
-  return counts[0]![1] > 0 ? counts[0]![0] : ",";
+  const sample = text.split("\n").slice(0, 10).filter((l) => l.trim() !== "").join("\n");
+  let best = { delimiter: ",", rows: 0, width: 1 };
+  for (const d of [",", "\t", ";", "|"]) {
+    if (!sample.includes(d)) continue;
+    const widths = new Map<number, number>();
+    for (const row of parseDelimited(sample, d)) {
+      if (row.length < 2) continue;
+      widths.set(row.length, (widths.get(row.length) ?? 0) + 1);
+    }
+    // The most common width, and how many lines share it; wider wins a tie.
+    for (const [width, rows] of widths) {
+      if (rows > best.rows || (rows === best.rows && width > best.width)) {
+        best = { delimiter: d, rows, width };
+      }
+    }
+  }
+  return best.delimiter;
 }
 
