From 18297695570d26c0bb174cf198a95259c2b44024 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 16:23:29 +0000
Subject: [PATCH] IMPORTS-5: a VPA is only the VPA, and a numeric one names
 nobody

The VPA pattern allowed hyphens on both sides of the @, so HDFC's
"UPI-SWIGGY-swiggy@icici-ICIC0DC0099-<RRN>-Payment" yielded a VPA from
"upi" to "payment" (no vpa rule could match) and the payee "Upi Swiggy
Swiggy"; IndusInd's "/-12345678@ptyb" became the payee "12345678"; and a
phone-number VPA segment beat the name as the merchant. The handle is now
letters and digits, the VPA and what follows it in its segment are not a
name, and IFSC-shaped parts are dropped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016zXWwzys3K4XksLh3rrcKu
---
 src/import/rules.test.ts | 27 +++++++++++++++++++++++++++
 src/import/rules.ts      | 30 ++++++++++++++++++++++++++----
 2 files changed, 53 insertions(+), 4 deletions(-)

diff --git a/src/import/rules.test.ts b/src/import/rules.test.ts
index dd5e08a..3d853f4 100644
--- a/src/import/rules.test.ts
+++ b/src/import/rules.test.ts
@@ -468,6 +468,33 @@ describe("B63 · the separator that introduced a reference goes with it", () =>
   });
 });
 
+describe("a VPA is only the VPA, and a numeric one names nobody", () => {
+  test("HDFC's dash-separated UPI line: the VPA stops at its handle", () => {
+    // UPI-<name>-<vpa>-<IFSC>-<RRN>-<note>. The VPA ran from "UPI" through the
+    // RRN — "upi-swiggy-swiggy@icici-icic0dc0099-…" — so a rule on "vpa is
+    // swiggy@icici" never matched and the payee read "Upi Swiggy Swiggy".
+    const f = extractNarrationFields("UPI-SWIGGY-swiggy@icici-ICIC0DC0099-123456789012-Payment");
+    assert.equal(f.vpa, "swiggy@icici");
+    assert.equal(f.merchant, "Swiggy");
+    assert.equal(f.reference, "123456789012");
+  });
+
+  test("a phone-number VPA leaves the name beside it as the merchant", () => {
+    // The IndusInd alert's own narration became the payee "12345678".
+    assert.equal(
+      extractNarrationFields("UPI/400111222333/DR/Moj/YESB0PTMUPI/-12345678@ptyb").merchant, "Moj",
+    );
+    assert.equal(
+      extractNarrationFields("UPI/DR/400111222666/FICTIONAL STORE/HDFC/9876543210@paytm/NA").merchant,
+      "Fictional Store",
+    );
+    assert.equal(
+      extractNarrationFields("UPI-FICTIONAL CAFE-9876543210@ybl-YESB0000001-400111222555-PAYMENT").merchant,
+      "Fictional Cafe",
+    );
+  });
+});
+
 describe("a reference is not part of a name", () => {
   test("a bracketed reference at the end is dropped", () => {
     // Axis writes "UPI TRANSFER TO ANITA RAO (500100000001)", and the number
diff --git a/src/import/rules.ts b/src/import/rules.ts
index 6edcc19..0bc0a1c 100644
--- a/src/import/rules.ts
+++ b/src/import/rules.ts
@@ -112,7 +112,14 @@ export function extractNarrationFields(narration: string): {
 
   const channel = CHANNELS.find((c) => new RegExp(`(^|[^A-Z])${c}([^A-Z]|$)`).test(upper)) ?? null;
 
-  const vpaMatch = /([a-z0-9._-]+@[a-z][a-z0-9.-]*)/i.exec(narration);
+  /*
+   * A VPA's handle is letters and digits ("okaxis", "ybl", "icici"), and its
+   * local part has no hyphen. Allowing hyphens on both sides read HDFC's
+   * "UPI-SWIGGY-swiggy@icici-ICIC0DC0099-123456789012-Payment" as one VPA
+   * from "UPI" to "Payment", and IndusInd's "/-12345678@ptyb" as a VPA whose
+   * local part was not all digits, so the payee became "12345678".
+   */
+  const vpaMatch = /([a-z0-9._]+@[a-z][a-z0-9]*)(?![a-z0-9.@])/i.exec(narration);
   const vpa = vpaMatch ? vpaMatch[1]!.toLowerCase() : null;
 
   // The UPI RRN is 12 digits; bank references run longer. Take the longest
@@ -120,12 +127,14 @@ export function extractNarrationFields(narration: string): {
   const numbers = narration.match(/\d{6,}/g) ?? [];
   const reference = numbers.length > 0 ? numbers.reduce((a, b) => (b.length >= a.length ? b : a)) : null;
 
-  const merchant = extractMerchant(narration, vpa, reference);
+  const merchant = extractMerchant(narration, vpa, reference, vpaMatch?.[1] ?? null);
 
   return { channel, vpa, merchant, reference };
 }
 
-function extractMerchant(narration: string, vpa: string | null, reference: string | null): string | null {
+function extractMerchant(
+  narration: string, vpa: string | null, reference: string | null, rawVpa: string | null,
+): string | null {
   // A VPA's local part is usually the merchant, and is the most reliable
   // signal when present.
   if (vpa) {
@@ -138,11 +147,22 @@ function extractMerchant(narration: string, vpa: string | null, reference: strin
   // A leading channel token is a rail, not a merchant: "NEFT-ACT FIBERNET"
   // should read "Act Fibernet". Only stripped at the start and only when a
   // separator follows, so a hyphen inside a real name survives.
-  const withoutRail = narration.replace(
+  let withoutRail = narration.replace(
     new RegExp(`^\\s*(?:${CHANNELS.join("|")})\\s*[-/: ]\\s*`, "i"),
     "",
   );
 
+  // A VPA that names nobody (a phone number) is not a name either, and in
+  // HDFC's dash-separated line everything after it — IFSC, RRN, note — is
+  // bank detail: the name is what came before it.
+  if (rawVpa) {
+    const at = withoutRail.indexOf(rawVpa);
+    if (at >= 0) {
+      const end = withoutRail.indexOf("/", at);
+      withoutRail = withoutRail.slice(0, at).replace(/-$/, "") + (end >= 0 ? withoutRail.slice(end) : "");
+    }
+  }
+
   const parts = withoutRail
     .split(/[/|]/)
     .map((p) => p.trim())
@@ -150,6 +170,8 @@ function extractMerchant(narration: string, vpa: string | null, reference: strin
     .filter((p) => !CHANNELS.includes(p.toUpperCase()))
     .filter((p) => p !== reference)
     .filter((p) => !/^(P2M|P2A|DR|CR|PAYMENT|TXN|REF)$/i.test(p))
+    // An IFSC ("YESB0PTMUPI", "HDFC0000001") is the payee's bank branch.
+    .filter((p) => !/^[A-Z]{4}0[A-Z0-9]{6}$/.test(p))
     .filter((p) => !/^\d+$/.test(p));
 
   if (parts.length === 0) return null;
