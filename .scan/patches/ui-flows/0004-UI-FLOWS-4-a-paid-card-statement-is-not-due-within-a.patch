Subject: [PATCH 4/6] UI-FLOWS-4: a paid card statement is not "due within a
 week"

The Cards header counted every card whose due date was seven days off or
less, including one marked Paid eleven days after it fell due.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016zXWwzys3K4XksLh3rrcKu
---
 src/web/cards-due-soon.test.ts | 30 ++++++++++++++++++++++++++++++
 src/web/pages/cards.ts         |  4 +++-
 2 files changed, 33 insertions(+), 1 deletion(-)
 create mode 100644 src/web/cards-due-soon.test.ts

diff --git a/src/web/cards-due-soon.test.ts b/src/web/cards-due-soon.test.ts
new file mode 100644
index 0000000..b4f7068
--- /dev/null
+++ b/src/web/cards-due-soon.test.ts
@@ -0,0 +1,30 @@
+/**
+ * "Due within a week" on the Cards screen counted every card whose due date was
+ * seven days off or less — including one whose statement had been paid eleven
+ * days ago. The demo showed "Due within a week: 1" above Axis Atlas marked
+ * "Paid" and two cards due in 12 and 15 days. Found driving /cards as Ravi.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { renderCards, type CardDue } from "./pages/cards.ts";
+import type { Paise } from "../core/money.ts";
+
+const card = (daysToDue: number, paid: number): CardDue => ({
+  accountId: "a" + daysToDue, name: "Card", last4: "0000", owed: 100_000 as Paise, funded: 0 as Paise,
+  unfunded: 100_000 as Paise,
+  statement: { amount: 150_000 as Paise, date: "2026-09-22", due: "2026-10-10", minimum: null },
+  daysToDue, paidSinceStatement: paid as Paise, paymentCategoryId: null,
+});
+
+const dueSoon = (cards: CardDue[]): string =>
+  /Due within a week ?<\/div> <strong[^>]*>(\d+)<\/strong>/.exec(
+    String(renderCards({ cards, month: "2026-10" })).replace(/\s+/g, " "),
+  )?.[1] ?? "missing";
+
+test("a paid statement is not due within a week, however recently it fell due", () => {
+  assert.equal(dueSoon([card(-11, 150_000), card(12, 0), card(15, 0)]), "0");
+});
+
+test("an unpaid one due in a few days, or overdue, still counts", () => {
+  assert.equal(dueSoon([card(3, 0), card(-2, 0), card(12, 0)]), "2");
+});
diff --git a/src/web/pages/cards.ts b/src/web/pages/cards.ts
index c93c947..45b67b1 100644
--- a/src/web/pages/cards.ts
+++ b/src/web/pages/cards.ts
@@ -76,7 +76,9 @@ export function renderCards(opts: { cards: CardDue[]; month: string }): SafeHtml
 
   const owed = cards.reduce((sum, c) => sum + c.owed, 0) as Paise;
   const unfunded = cards.reduce((sum, c) => sum + c.unfunded, 0) as Paise;
-  const dueSoon = cards.filter((c) => c.daysToDue !== null && c.daysToDue <= 7);
+  // A statement already paid is not due, however recently it fell due (B127).
+  const dueSoon = cards.filter((c) =>
+    c.daysToDue !== null && c.daysToDue <= 7 && urgency(c)?.label !== "Paid");
 
   return html`
     <h1>Cards</h1>
