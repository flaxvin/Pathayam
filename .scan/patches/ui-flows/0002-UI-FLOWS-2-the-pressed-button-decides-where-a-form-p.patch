From 2c299e327683d753352cf6b19edee2999e43a316 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 16:44:00 +0000
Subject: [PATCH 2/6] UI-FLOWS-2: the pressed button decides where a form posts
 and what it sends

Review's "No thanks" on a proposed rule carries formaction=/rules/dismiss,
and the client posted form.action with FormData(form): declining a rule
confirmed it ("Rule confirmed."). The Move screen's suggestion buttons
name their source and lost it the same way, sending the select's default.
The client now uses event.submitter's formaction and sets its name/value.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016zXWwzys3K4XksLh3rrcKu
---
 src/web/client.test.ts | 10 ++++++++++
 src/web/client.ts      | 23 ++++++++++++++++++-----
 2 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/src/web/client.test.ts b/src/web/client.test.ts
index c8e268f..2e67146 100644
--- a/src/web/client.test.ts
+++ b/src/web/client.test.ts
@@ -34,6 +34,16 @@ describe("S15 · the client script", () => {
     assert.match(CLIENT_SCRIPT, /input\[type="file"\]/);
   });
 
+  test("the button that was pressed decides where the form goes and what it says", () => {
+    // Review's "No thanks" carries formaction="/rules/dismiss" and the Move
+    // screen's suggestions carry name/value pairs. Posting form.action with
+    // FormData(form) dropped both: "No thanks" confirmed the rule, and a
+    // suggestion sent the select's default source instead of its own.
+    assert.match(CLIENT_SCRIPT, /submitWithRetry\(form, event\.submitter\)/);
+    assert.match(CLIENT_SCRIPT, /formData\.set\(submitter\.name, submitter\.value\)/);
+    assert.match(CLIENT_SCRIPT, /submitter\.hasAttribute\("formaction"\)/);
+  });
+
   test("B60 · a successful mutation updates in place rather than navigating", () => {
     // The two calls that threw away the scroll position, and the message.
     assert.equal(
diff --git a/src/web/client.ts b/src/web/client.ts
index d0c0f26..c18db83 100644
--- a/src/web/client.ts
+++ b/src/web/client.ts
@@ -243,8 +243,16 @@ export const CLIENT_SCRIPT = String.raw`
     window.location.reload();
   });
 
-  function submitWithRetry(form) {
-    var submitButton = form.querySelector('button[type="submit"], button:not([type])');
+  function submitWithRetry(form, submitter) {
+    /*
+     * The pressed button decides where the form goes and what it adds: Review's
+     * "No thanks" carries formaction="/rules/dismiss", and the Move screen's
+     * suggestions each name their source. Posting form.action with only the
+     * form's own fields confirmed a rule the household had just declined.
+     */
+    if (submitter && submitter.form !== form) submitter = null;
+    var action = submitter && submitter.hasAttribute("formaction") ? submitter.formAction : form.action;
+    var submitButton = submitter || form.querySelector('button[type="submit"], button:not([type])');
     var originalLabel = submitButton ? submitButton.textContent : null;
     var key = form.dataset.idempotencyKey || newKey();
     form.dataset.idempotencyKey = key;
@@ -266,9 +274,14 @@ export const CLIENT_SCRIPT = String.raw`
       }
       setStatus(form, attempt === 0 ? "Saving…" : "Still trying…", null);
 
-      var body = new URLSearchParams(new FormData(form));
+      var formData = new FormData(form);
+      // Set by hand rather than FormData(form, submitter), which older Safari
+      // does not take. Set, not appended: a suggestion button shares its name
+      // with the select below it, and the button pressed is the answer.
+      if (submitter && submitter.name) formData.set(submitter.name, submitter.value);
+      var body = new URLSearchParams(formData);
 
-      fetch(form.action, {
+      fetch(action, {
         method: "POST",
         headers: {
           "Content-Type": "application/x-www-form-urlencoded",
@@ -352,7 +365,7 @@ export const CLIENT_SCRIPT = String.raw`
       return;
     }
     event.preventDefault();
-    submitWithRetry(form);
+    submitWithRetry(form, event.submitter);
   });
 
   // Carry the current URL into the theme toggle so it returns you here (R39.5).
